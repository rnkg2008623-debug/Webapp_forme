rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // ドキュメントID「A_B」に自分のIDが含まれているか
    function inId(id) { return id.split('_')[0] == uid() || id.split('_')[1] == uid(); }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function validDesc(d) { return !('description' in d) || (d.description is string && d.description.size() <= 60); }

    // プロフィール: 1件ずつ取得のみ(一覧は不可)。メールアドレスは保存しない。
    match /users/{userId} {
      allow get: if signedIn();
      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasOnly(['displayName', 'friendCode', 'createdAt', 'description'])
        && validName(request.resource.data.displayName)
        && validDesc(request.resource.data)
        && getAfter(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCode)).data.uid == uid();
      allow update: if signedIn() && userId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'description'])
        && validName(request.resource.data.displayName)
        && validDesc(request.resource.data);

      // 自分だけに見えるフレンドのメモ
      match /memos/{friendId} {
        allow read: if signedIn() && userId == uid();
        allow create, update: if signedIn() && userId == uid()
          && request.resource.data.keys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 60;
        allow delete: if signedIn() && userId == uid();
      }
    }

    // フレンドコード → ユーザーID。コードを知っている人だけが引ける(一覧は不可)。
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 8
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == uid();
    }

    // フレンド申請: ID は「送信者_受信者」
    match /friendRequests/{id} {
      allow get: if signedIn() && inId(id);
      allow list: if signedIn() && (resource.data.from == uid() || resource.data.to == uid());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt'])
        && request.resource.data.from == uid()
        && request.resource.data.to is string
        && request.resource.data.to != uid()
        && request.resource.data.status == 'pending'
        && id == uid() + '_' + request.resource.data.to;
      allow delete: if signedIn() && inId(id);   // 承認・拒否・取消
    }

    // フレンド関係: ID は2人のIDを並べ替えて「A_B」。相手からの申請が存在するときだけ作れる。
    match /friendships/{id} {
      function otherOf(members) { return members[0] == uid() ? members[1] : members[0]; }

      allow get: if signedIn() && inId(id);
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'since'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && uid() in request.resource.data.members
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/friendRequests/$(otherOf(request.resource.data.members) + '_' + uid()));
      allow delete: if signedIn() && inId(id);   // どちらからでも解除できる
    }
  }
}
