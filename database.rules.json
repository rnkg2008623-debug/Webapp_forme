{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'changed']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|busy|offline)$/)"
      }
    }
  }
}
