{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'changed'])",
        "state": { ".validate": "newData.isString() && newData.val().matches(/^(online|busy|offline)$/)" },
        "changed": { ".validate": "newData.isNumber()" },
        "studying": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
